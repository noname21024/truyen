{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truyen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/icons/*",
      "!/model/*",
      "!/data/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/logo.ico",
      "!/logo.png",
      "!/logo.svg",
      "!/icons.svg"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
